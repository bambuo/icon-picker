{
  "$schema": "发布配置：cd deploy && bun publish.mjs [--rid osx-arm64]",
  "runtimes": [
    "osx-arm64",
    "win-x64"
  ],
  "app": {
    "name": "图标筛选工作台",
    "bundleId": "com.bambuo.iconpicker",
    "version": "1.0.0",
    "icon": "assets/AppIcon.icns",
    "launcher": "app/launcher.swift"
  },
  "frontend": {
    "buildCmd": "bun run build",
    "dist": "../frontend/dist"
  },
  "backend": {
    "project": "../backend/IconPicker.Api.csproj"
  },
  "package": {
    "outDir": "out"
  }
}
